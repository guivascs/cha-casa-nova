<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Painel administrativo</title><link rel="stylesheet" href="/style.css"></head><body><header><h1>🔧 Painel administrativo</h1><a href="/logout">Sair</a></header><main class="admin"><section class="admin-sidebar"><section class="card admin-form"><h2>➕ Adicionar presente</h2><form method="POST" action="/admin/gifts"><label for="name">Nome do presente:</label><input id="name" name="name" type="text" placeholder="Ex: Jogo de panelas" required autofocus><button type="submit">Adicionar presente</button></form></section><section class="card import-card"><h2>📄 Importar CSV</h2><p>Use uma coluna chamada <strong>nome</strong>.</p><form method="POST" action="/admin/gifts/import" enctype="multipart/form-data"><label for="csvFile">Arquivo CSV:</label><input id="csvFile" name="csvFile" type="file" accept=".csv,text/csv" required><button type="submit">Importar presentes</button></form><code>nome<br>Jogo de panelas<br>Liquidificador</code></section></section><section class="card wide"><h2>📦 Reservas</h2><% if (importResult) { %><div class="import-result <%= importResult.type %>"><%= importResult.text %></div><% } %><% if (gifts.length === 0) { %><p class="empty-admin">Nenhum presente cadastrado ainda.</p><% } else { %><table><thead><tr><th>Presente</th><th>Status</th><th>Reservado por</th><th>Ações</th></tr></thead><tbody><% gifts.forEach(function (gift) { %><tr><td><strong><%= gift.name %></strong></td><td><strong class="<%= gift.reserved_by ? 'status-reserved' : 'status-available' %>"><%= gift.reserved_by ? '🔒 Reservado' : '✓ Disponível' %></strong></td><td><%= gift.reserved_by_name || '-' %></td><td><% if (gift.reserved_by) { %><form class="inline" method="POST" action="/admin/gifts/<%= gift.id %>/reset"><button type="submit">Resetar</button></form><% } %><form class="inline" method="POST" action="/admin/gifts/<%= gift.id %>/delete" onsubmit="return confirm('Tem certeza que deseja excluir este presente?')"><button type="submit" class="danger">Excluir</button></form></td></tr><% }); %></tbody></table><% } %></section></main></body></html>
