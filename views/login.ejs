<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chá de Casa Nova do Gui - Login</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="card login-card">
    <div class="login-avatar-wrapper">
      <img src="/avatar.png" alt="Gui" class="login-avatar">
    </div>
    <h1>🎮 CHÁ DE CASA NOVA DO GUI</h1>
    <p>PLAYER 1: DIGITE SEU NOME PARA ENTRAR NO JOGO E ESCOLHER SEU ITEM!</p>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <label for="name">NOME DO JOGADOR(A):</label>
      <input id="name" name="name" type="text" placeholder="Ex: Maria Silva" required maxlength="80" autofocus autocomplete="name">
      <button type="submit">PRESS START 🕹️</button>
    </form>
    <a href="/admin/login" class="admin-link">🔒 MODO ADMIN</a>
  </main>
</body>
</html>