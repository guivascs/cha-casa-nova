<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Lista de presentes</title><link rel="stylesheet" href="/style.css"></head><body><header><h1>🎁 Lista de presentes</h1><a href="/logout">Sair</a></header><main><p class="welcome">Olá, <strong><%= userName %></strong>! Obrigado por participar do nosso chá de casa nova! 🏠</p><div id="message" class="message" role="alert"></div><div class="list-container"><% if (gifts.length === 0) { %><p class="empty">Nenhum presente cadastrado ainda.</p><% } %><% gifts.forEach(function (gift) { %><article class="list-item <%= gift.reserved_by ? 'reserved' : '' %>"><h2><%= gift.name %></h2><div class="list-action"><% if (gift.reserved_by) { %><span class="badge reserved">🔒 Reservado</span><% } else { %><button type="button" onclick='reserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>, this)'>Escolher presente</button><% } %></div></article><% }); %></div></main><script>function showMessage(text){const el=document.getElementById('message');el.textContent=text;el.className='message error';el.style.display='block';}async function reserve(id,name,button){if(!confirm(`Você está escolhendo: ${name}\n\nApós confirmar, esta escolha não poderá ser alterada.\n\nDeseja continuar?`))return;button.disabled=true;button.textContent='Reservando...';try{const response=await fetch(`/gifts/${id}/reserve`,{method:'POST',headers:{Accept:'application/json'}});const data=await response.json().catch(()=>({}));if(response.ok)return location.reload();showMessage(data.error||'Não foi possível reservar este presente.');}catch(e){showMessage('Erro de conexão. Tente novamente.');}button.disabled=false;button.textContent='Escolher presente';}</script></body></html>