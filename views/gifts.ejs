<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de presentes - Chá de Casa Nova</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏡</text></svg>">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="guest-page">
  <header>
    <div class="header-brand">
      <img src="/avatar.png" alt="Gui" class="header-avatar">
      <div>
        <h1>Chá de Casa Nova do Gui</h1>
        <p class="header-subtitle">Escolha um ou mais presentes para a minha casa nova!</p>
      </div>
    </div>
    <a href="/logout" class="btn btn-outline-danger">Sair</a>
  </header>

  <main class="guest-container">
    <div class="welcome-box">
      <h2>Olá, <strong><%= userName %></strong>! 👋</h2>
      <p>Obrigado por fazer parte desse momento tão especial comigo! Você pode escolher <strong>quantos presentes quiser</strong> da lista abaixo.</p>
    </div>

    <div id="message" class="message" role="alert"></div>
    <div id="toast" class="toast" role="status"></div>

    <% if (groups.length) { %>
    <div class="guest-toolbar">
      <input type="search" id="giftSearch" class="guest-search" placeholder="🔍 Buscar presente..." autocomplete="off">
      <label class="only-available"><input type="checkbox" id="onlyAvailable"> Só disponíveis</label>
      <nav class="category-chips" aria-label="Ambientes">
        <% groups.forEach(function (group) { %>
          <a href="#cat-<%= group.category %>" class="chip"><%= group.category %></a>
        <% }); %>
      </nav>
    </div>
    <% } %>

    <!-- Seção de presentes já escolhidos pelo convidado -->
    <% if (myGifts && myGifts.length > 0) { %>
      <section class="my-gifts-card">
        <div class="my-gifts-header">
          <h3>🎉 Seus presentes escolhidos (<%= myGifts.length %>)</h3>
          <span class="my-gifts-subtitle">Muito obrigado pelo carinho!</span>
        </div>
        <div class="my-gifts-list">
          <% myGifts.forEach(function (gift) { %>
            <div class="my-gift-item">
              <div class="my-gift-info">
                <span class="my-gift-bullet">✓</span>
                <div>
                  <strong><%= gift.name %></strong>
                  <div class="gift-tags">
                    <span class="category-tag"><%= gift.category %></span>
                    <% if (gift.color) { %>
                      <span class="color-tag">🎨 Cor preferida: <strong><%= gift.color %></strong></span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Lista de todos os presentes por categoria -->
    <% if (!groups.length) { %>
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h3>Nenhum presente cadastrado ainda.</h3>
      </div>
    <% } %>

    <% groups.forEach(function (group) { %>
      <section class="category-section" id="cat-<%= group.category %>">
        <h2 class="category-title"><%= group.category %></h2>
        <div class="list-container">
          <% group.gifts.forEach(function (gift) { %>
            <% const isMine = (gift.reserved_by === userId); %>
            <% const isReservedByOther = (gift.reserved_by && !isMine); %>

            <article data-name="<%= gift.name.toLowerCase() %>" data-reserved="<%= isReservedByOther ? 1 : 0 %>" class="list-item <%= isMine ? 'item-mine' : (isReservedByOther ? 'reserved' : '') %>">
              <% if (gift.image_url) { %><img src="<%= gift.image_url %>" alt="<%= gift.name %>" class="item-image" loading="lazy"><% } %>
              <div class="item-details">
                <h3><%= gift.name %></h3>
                <% if (gift.color) { %>
                  <div class="color-badge">
                    <span class="color-icon">🎨</span>
                    <span>Cor preferida: <strong><%= gift.color %></strong></span>
                  </div>
                <% } %>
                <% if (isMine) { %>
                  <span class="badge-status badge-mine">✓ Escolhido por você</span>
                <% } %>
              </div>

              <div class="list-action">
                <% if (isMine) { %>
                  <span class="badge-status badge-mine">✓ Seu presente</span>
                <% } else if (isReservedByOther) { %>
                  <span class="badge reserved">🔒 Já reservado</span>
                <% } else { %>
                  <button type="button" class="btn-choose" onclick='reserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>, <%- JSON.stringify(gift.color || "") %>, this)'>
                    Escolher
                  </button>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </main>

  <div id="sheet" class="sheet-backdrop" onclick="if(event.target===this)closeSheet()">
    <div class="sheet" role="dialog" aria-modal="true">
      <h3>Escolher este presente?</h3>
      <p id="sheetName" class="sheet-name"></p>
      <p id="sheetColor" class="sheet-color"></p>
      <button type="button" id="sheetOk" class="btn-choose btn-big">Sim, quero este presente</button>
      <button type="button" class="btn-cancel btn-big" onclick="closeSheet()">Cancelar</button>
    </div>
  </div>

  <script>
    function showMessage(text, isSuccess) {
      const el = document.getElementById('message');
      el.textContent = text;
      el.className = isSuccess ? 'message success' : 'message error';
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    const setHeaderH = () => document.documentElement.style.setProperty('--header-h', document.querySelector('header').offsetHeight + 'px');
    setHeaderH(); window.addEventListener('resize', setHeaderH);
    let sheetAction = null;
    function closeSheet() { document.getElementById('sheet').classList.remove('open'); sheetAction = null; }
    function reserve(id, name, color, button) {
      document.getElementById('sheetName').textContent = name;
      document.getElementById('sheetColor').textContent = color ? `🎨 Cor preferida: ${color}` : '';
      sheetAction = () => doReserve(id, name, button);
      document.getElementById('sheet').classList.add('open');
    }
    document.getElementById('sheetOk').addEventListener('click', () => { const run = sheetAction; closeSheet(); if (run) run(); });

    async function doReserve(id, name, button) {
      button.disabled = true;
      button.textContent = 'Reservando...';
      try {
        const response = await fetch(`/gifts/${id}/reserve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' }
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok) {
          try { sessionStorage.setItem('toast', `🎉 "${name}" é seu! Obrigado pelo carinho.`); } catch (e) {}
          return location.reload();
        }
        showMessage(data.error || 'Não foi possível reservar este presente.', false);
      } catch (e) {
        showMessage('Erro de conexão. Tente novamente.', false);
      }
      button.disabled = false;
      button.textContent = 'Escolher';
    }

    function applyFilters() {
      const q = document.getElementById('giftSearch').value.trim().toLowerCase();
      const onlyAvail = document.getElementById('onlyAvailable').checked;
      document.querySelectorAll('.category-section').forEach(section => {
        let visible = 0;
        section.querySelectorAll('.list-item').forEach(item => {
          const show = item.dataset.name.includes(q) && !(onlyAvail && item.dataset.reserved === '1');
          item.style.display = show ? '' : 'none';
          if (show) visible += 1;
        });
        section.style.display = visible ? '' : 'none';
      });
    }
    const searchEl = document.getElementById('giftSearch');
    if (searchEl) {
      searchEl.addEventListener('input', applyFilters);
      document.getElementById('onlyAvailable').addEventListener('change', applyFilters);
    }
    try {
      const msg = sessionStorage.getItem('toast');
      if (msg) {
        sessionStorage.removeItem('toast');
        const t = document.getElementById('toast');
        t.textContent = msg; t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 4500);
      }
    } catch (e) {}
  </script>
</body>
</html>
