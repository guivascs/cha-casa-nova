<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de presentes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1>🎁 Lista de presentes</h1>
    <a href="/logout">Sair</a>
  </header>

  <main>
    <p class="welcome">Olá, <strong><%= userName %></strong>! Obrigado por participar do nosso chá de casa nova! 🏠</p>
    <div id="message" class="message" role="alert" aria-live="polite"></div>

    <div class="list-container">
      <% if (gifts.length === 0) { %>
        <p class="empty">Nenhum presente cadastrado ainda.</p>
      <% } %>

      <% gifts.forEach(function (gift) { %>
        <article class="list-item <%= gift.reserved_by ? 'reserved' : '' %>">
          <div class="list-content">
            <h2><%= gift.name %></h2>
            <% if (gift.description) { %><p><%= gift.description %></p><% } %>
          </div>
          <div class="list-action">
            <% if (gift.reserved_by) { %>
              <span class="badge reserved">🔒 Reservado</span>
            <% } else { %>
              <button type="button" onclick='reserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>, this)'>Escolher presente</button>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  </main>

  <script>
    function showMessage(text, type = 'error') {
      const message = document.getElementById('message');
      message.textContent = text;
      message.className = `message ${type}`;
      message.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function reserve(id, name, button) {
      const confirmed = confirm(`Você está escolhendo: ${name}\n\nApós confirmar, esta escolha não poderá ser alterada.\n\nDeseja continuar?`);
      if (!confirmed) return;

      button.disabled = true;
      button.textContent = 'Reservando...';

      try {
        const response = await fetch(`/gifts/${id}/reserve`, {
          method: 'POST',
          headers: { 'Accept': 'application/json' }
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok) {
          location.reload();
          return;
        }

        showMessage(data.error || 'Não foi possível reservar este presente.');
        button.disabled = false;
        button.textContent = 'Escolher presente';
      } catch (error) {
        showMessage('Erro de conexão. Verifique se o servidor está em execução e tente novamente.');
        button.disabled = false;
        button.textContent = 'Escolher presente';
      }
    }
  </script>
</body>
</html>
