<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de presentes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1>🎁 Lista de presentes</h1>
    <a href="/logout">Sair</a>
  </header>
  <main>
    <p class="welcome">Olá, <strong><%= userName %></strong>! Obrigado por participar do nosso chá de casa nova! 🏠</p>
    <div class="list-container">
      <% if (gifts.length === 0) { %>
        <p class="empty">Nenhum presente cadastrado ainda.</p>
      <% } %>
      <% gifts.forEach(function (gift) { %>
        <article class="list-item <%= gift.reserved_by ? 'reserved' : '' %>">
          <div class="list-content">
            <h2><%= gift.name %></h2>
            <% if (gift.description) { %><p><%= gift.description %></p><% } %>
          </div>
          <div class="list-action">
            <% if (gift.reserved_by) { %>
              <span class="badge reserved">🔒 Reservado</span>
            <% } else { %>
              <button type="button" onclick="reserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>)">Escolher presente</button>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  </main>
  <script>
    async function reserve(id, name) {
      const confirmed = confirm(`Você está escolhendo: ${name}\n\nApós confirmar, esta escolha não poderá ser alterada.\n\nDeseja continuar?`);
      if (!confirmed) return;
      try {
        const response = await fetch(`/gifts/${id}/reserve`, { method: 'POST' });
        if (response.ok) return location.reload();
        const data = await response.json();
        alert(data.error || 'Não foi possível reservar este presente.');
        location.reload();
      } catch (error) {
        alert('Erro de conexão. Tente novamente.');
      }
    }
  </script>
</body>
</html>
