<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de presentes - Chá de Casa Nova</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="guest-page">
  <header>
    <div class="header-brand">
      <img src="/avatar.png" alt="Gui" class="header-avatar">
      <div>
        <h1>🎮 CHÁ DE CASA NOVA DO GUI</h1>
        <p class="header-subtitle">MISSÃO: ESCOLHA ITENS PARA COMPLETAR O NOVO CASTELO!</p>
      </div>
    </div>
    <a href="/logout" class="btn btn-outline-danger">Sair [ESC]</a>
  </header>

  <main class="guest-container">
    <div class="welcome-box">
      <h2>BEM-VINDO, PLAYER <strong><%= userName %></strong>! 👾</h2>
      <p>Obrigado por jogar junto comigo nesta nova fase! Escolha quantos itens quiser da lista de itens abaixo.</p>
    </div>

    <div id="message" class="message" role="alert"></div>

    <!-- Seção de presentes já escolhidos pelo convidado -->
    <% if (myGifts && myGifts.length > 0) { %>
      <section class="my-gifts-card">
        <div class="my-gifts-header">
          <h3>🎒 SEU INVENTÁRIO (<%= myGifts.length %> ITENS)</h3>
          <span class="my-gifts-subtitle">⭐ OBRIGADO PELO CARINHO!</span>
        </div>
        <div class="my-gifts-list">
          <% myGifts.forEach(function (gift) { %>
            <div class="my-gift-item">
              <div class="my-gift-info">
                <span class="my-gift-bullet">✓</span>
                <div>
                  <strong><%= gift.name %></strong>
                  <span class="category-tag"><%= gift.category %></span>
                </div>
              </div>
              <button type="button" class="btn-unreserve" onclick='unreserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>, this)'>
                Desistir deste item
              </button>
            </div>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Lista de todos os presentes por categoria -->
    <% if (!groups.length) { %>
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h3>Nenhum presente cadastrado ainda.</h3>
      </div>
    <% } %>

    <% groups.forEach(function (group) { %>
      <section class="category-section">
        <h2 class="category-title"><%= group.category %></h2>
        <div class="list-container">
          <% group.gifts.forEach(function (gift) { %>
            <% const isMine = (gift.reserved_by === userId); %>
            <% const isReservedByOther = (gift.reserved_by && !isMine); %>

            <article class="list-item <%= isMine ? 'item-mine' : (isReservedByOther ? 'reserved' : '') %>">
              <div class="item-details">
                <h3><%= gift.name %></h3>
                <% if (isMine) { %>
                  <span class="badge-status badge-mine">★ COLETADO POR VOCÊ</span>
                <% } %>
              </div>

              <div class="list-action">
                <% if (isMine) { %>
                  <button type="button" class="btn-unreserve" onclick='unreserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>, this)'>
                    Largar item
                  </button>
                <% } else if (isReservedByOther) { %>
                  <span class="badge reserved">🔒 JÁ COLETADO</span>
                <% } else { %>
                  <button type="button" class="btn-choose" onclick='reserve(<%= gift.id %>, <%- JSON.stringify(gift.name) %>, this)'>
                    + COLETAR ITEM
                  </button>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </main>

  <script>
    function showMessage(text, isSuccess) {
      const el = document.getElementById('message');
      el.textContent = text;
      el.className = isSuccess ? 'message success' : 'message error';
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function reserve(id, name, button) {
      if (!confirm(`Deseja escolher o presente: "${name}"?`)) return;
      button.disabled = true;
      button.textContent = 'Reservando...';
      try {
        const response = await fetch(`/gifts/${id}/reserve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' }
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok) return location.reload();
        showMessage(data.error || 'Não foi possível reservar este presente.', false);
      } catch (e) {
        showMessage('Erro de conexão. Tente novamente.', false);
      }
      button.disabled = false;
      button.textContent = 'Escolher presente';
    }

    async function unreserve(id, name, button) {
      if (!confirm(`Deseja desistir da escolha de "${name}" e deixá-lo disponível para outro convidado?`)) return;
      button.disabled = true;
      button.textContent = 'Cancelando...';
      try {
        const response = await fetch(`/gifts/${id}/unreserve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' }
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok) return location.reload();
        showMessage(data.error || 'Não foi possível cancelar a escolha.', false);
      } catch (e) {
        showMessage('Erro de conexão. Tente novamente.', false);
      }
      button.disabled = false;
      button.textContent = 'Desistir';
    }
  </script>
</body>
</html>
